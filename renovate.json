{
    "prCreation": "immediate",
    "prConcurrentLimit": 10,
    "prHourlyLimit": 10,
    "customManagers": [
        {
            "customType": "regex",
            "description": "Containerfile ARG version pins annotated with a renovate comment",
            "managerFilePatterns": [
                "/(^|/)Containerfile$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\nARG (?<key>[A-Z0-9_]+)\\s*=\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
            ]
        },
        {
            "customType": "jsonata",
            "description": "Update baseline of vcpkg registry",
            "managerFilePatterns": [
                "/vcpkg-configuration.json$/"
            ],
            "fileFormat": "json",
            "datasourceTemplate": "git-refs",
            "matchStrings": [
                "$.\"default-registry\".{\"packageName\": repository,  \"currentValue\":\"master\", \"currentDigest\": baseline}"
            ]
        }
    ],
    "packageRules": [
        {
            "matchManagers": [
                "custom.regex"
            ],
            "matchFileNames": [
                "**/Containerfile"
            ],
            "minimumReleaseAge": "1 month"
        },
        {
            "description": "Containerfile image updates",
            "matchDatasources": [
                "docker"
            ],
            "matchFileNames": [
                "**/Containerfile"
            ],
            "minimumReleaseAge": null
        },
        {
            "matchFileNames": [
                "vcpkg-configuration.json"
            ],
            "groupName": "vcpkg configuration update",
            "minimumReleaseAge": null
        }
    ]
}