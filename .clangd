CompileFlags:
  Compiler: clang++
  CompilationDatabase: build

  Add:
    - --cuda-path=/usr/local/cuda
    - -I/usr/local/cuda/targets/x86_64-linux/include
    - -I/usr/local/cuda/targets/x86_64-linux/include/cccl
    - --cuda-gpu-arch=sm_86

    # CUDA 13.x is newer than clangd 22's reported CUDA support window. These
    # keep that version skew from becoming a top-level diagnostic.
    # - -Wno-unknown-cuda-version
    # - -Wno-pragma-system-header-outside-header

  Remove:
    # Strip nvcc-only flags
    - -G
    - -stdpar
    - "-Xfatbin*"
    - "-Xcompiler*"
    - "-Xcudafe*"
    - "-rdc=*"
    - "-gpu=*"
    - "--diag_suppress*"
    - "-gencode*"
    - "--generate-code*"
    - -fcoroutines
    - "-ccbin*"
    - "--compiler-options*"
    - "--extended-lambda"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
    - "-allow-unsupported-compiler"
    - "-x cu"

---

# Force CUDA language mode only for CUDA source files, so host .cpp/.h files in
# the project are still parsed as ordinary C++. Projects that intentionally use
# CUDA syntax in other file extensions should extend this PathMatch rule.
If:
  PathMatch: '.*\.(cu|cuh)$'
CompileFlags:
  Add:
    - -x
    - cuda
Diagnostics:
  Suppress:
    # Known clang CUDA-front-end false positives.
    - "variadic_device_fn"
    - "attributes_not_allowed"
    - "template_param_shadow"
    - "deduction_guide_target_attr"
    - "shared_var_init"
