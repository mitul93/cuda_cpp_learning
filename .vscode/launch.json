{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CUDA C++: Launch",
            "type": "cuda-gdb",
            "request": "launch",
            "preLaunchTask": "Build Example(s)",
            "program": "${workspaceFolder}/build/src/${fileDirnameBasename}/${fileDirnameBasename}",
            "cwd": "${workspaceFolder}/build/",
            "debuggerPath": "/usr/local/cuda/bin/cuda-gdb"
        },
        {
            "name": "CUDA C++: Attach",
            "type": "cuda-gdb",
            "request": "attach",
            "processId": "${command:cuda.pickProcess}"
        },
    ]
}